# DomainsDispute.com — Environment Variables
# Copy this to .env and fill in real values.
# Never commit .env to git. Keep secrets in GitHub Actions secrets.

# Supabase (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # SECRET — server only

# AI providers (Phase 3 — leave blank for Week 1)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe (Phase 2 — leave blank for Week 1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Brevo (transactional + marketing email)
BREVO_API_KEY=
