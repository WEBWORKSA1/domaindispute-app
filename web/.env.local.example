# Local dev environment - copy to .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Meilisearch - self-hosted
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=local-dev-key
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=public-search-only-key

# Brevo
BREVO_API_KEY=

# Site config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=DomainsDispute.com
